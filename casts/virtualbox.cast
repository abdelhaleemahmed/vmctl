[14.514537, "o", "virtualbox: 7 cases -- [('parallels', 'ide'), ('qcow2', 'sata'), ('qed', 'scsi'), ('raw', 'sas'), ('vdi', 'nvme'), ('vhd', 'virtio-scsi'), ('vmdk', 'usb')]\r\r\n\r\r\n=== virtualbox: format=parallels bus=ide ===\r\r\n$ vmctl -p virtualbox validate C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-56bwp4io\\vmctl-t-parallels-ide.yaml\r\r\n  Configuration is valid!\r\r\n    VM Name: vmctl-t-parallels-ide\r\r\n    CPU:     1 cores\r\r\n    Memory:  128 MB\r\r\n    Disks:   1\r\r\n  -> exit 0\r\r\n  [ok] the spec validates\r\r\n$ vmctl -p virtualbox import C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-56bwp4io\\vmctl-t-parallels-ide.yaml --policy nearest --execute\r\r\n  Created VM 'vmctl-t-parallels-ide' from C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-56bwp4io\\vmctl-t-parallels-ide.yaml\r\r\n      1: VBoxManage createvm --name vmctl-t-parallels-ide --ostype Ubuntu_64 --register\r\r\n      2: VBoxManage modifyvm vmctl-t-parallels-ide --memory 128 --vram 16 --cpus 1 --firmware bios --acpi on --ioapic off --rtcuseutc on --pae off --nested-hw-virt off --cpuhotplug off --pagefusion off --hpet off --clipboard-mode disabled --draganddrop disabled\r\r\n      3: VBoxManage storagectl vmctl-t-parallels-ide --name IDE Controller --add ide --controller PIIX4 --portcount 2 --bootable on\r\r\n      4: VBoxManage createmedium disk --filename C:\\vagrant-storage-labs\\vms\\vmctl-t-parallels-ide\\vmctl-t-parallels-ide_system.hdd --size 100 --format Parallels --variant Standard\r\r\n      5: VBoxManage storageattach vmctl-t-parallels-ide --storagectl IDE Controller --port 0 --device 0 --type hdd --medium C:\\vagrant-storage-labs\\vms\\vmctl-t-parallels-ide\\vmctl-t-parallels-ide_system.hdd\r\r\n      6: VBoxManage modifyvm vmctl-t-parallels-ide --boot1 disk\r\r\n      7: VBoxManage modifyvm vmctl-t-parallels-ide --boot2 dvd\r\r\n      8: VBoxManage modifyvm vmctl-t-parallels-ide --boot3 none\r\r\n      9: VBoxManage modifyvm vmctl-t-parallels-ide --boot4 none\r\r\n  -> exit 0\r\r\n  [ok] the VM is created\r\r\n$ vmctl -p virtualbox list\r\r\n  NAME                           STATUS      \r\r\n"]
