[41.411653, "o", "\r\r\n  [ok] the added disk is there -- 2 storage device(s)\r\r\n  [ok] the disks are parallels as asked -- reported ['parallels']\r\r\n  [ok] the disks are on ide as asked -- reported ['ide']\r\r\n$ vmctl -p virtualbox export vmctl-t-parallels-ide-ov -o C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-w8waq0ia\\vmctl-t-parallels-ide.json\r\r\n  Exported 'vmctl-t-parallels-ide-ov' -> C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-w8waq0ia\\vmctl-t-parallels-ide.json\r\r\n  -> exit 0\r\r\n  [ok] export writes the file\r\r\n  [ok] a .json file contains JSON\r\r\n$ vmctl -p virtualbox import C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-w8waq0ia\\vmctl-t-parallels-ide.json --new-name vmctl-t-parallels-ide-rt --policy nearest --execute\r\r\n  Created VM 'vmctl-t-parallels-ide-rt' from C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-w8waq0ia\\vmctl-t-parallels-ide.json\r\r\n      1: VBoxManage createvm --name vmctl-t-parallels-ide-rt --ostype Ubuntu_64 --register\r\r\n      2: VBoxManage modifyvm vmctl-t-parallels-ide-rt --memory 256 --vram 16 --cpus 2 --firmware bios --acpi on --ioapic off --rtcuseutc on --pae off --nested-hw-virt off --cpuhotplug off --pagefusion off --hpet off --clipboard-mode disabled --draganddrop disabled\r\r\n      3: VBoxManage storagectl vmctl-t-parallels-ide-rt --name IDE Controller --add ide --controller PIIX4 --portcount 2 --bootable on\r\r\n      4: VBoxManage createmedium disk --filename C:\\vagrant-storage-labs\\vms\\vmctl-t-parallels-ide-rt\\vmctl-t-parallels-ide-rt_disk_IDE_Controller_0_0.hdd --size 100 --format Parallels --variant Standard\r\r\n      5: VBoxManage storageattach vmctl-t-parallels-ide-rt --storagectl IDE Controller --port 0 --device 0 --type hdd --medium C:\\vagrant-storage-labs\\vms\\vmctl-t-parallels-ide-rt\\vmctl-t-parallels-ide-rt_disk_IDE_Controller_0_0.hdd\r\r\n      6: VBoxManage createmedium disk --filename C:\\vagrant-storage-labs\\vms\\vmctl-t-parallels-ide-rt\\vmctl-t