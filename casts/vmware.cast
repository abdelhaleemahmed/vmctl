[16.491398, "o", "\r\n\r\r\n=== vmware: format=vmdk bus=ide ===\r\r\n$ vmctl -p vmware validate C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.yaml\r\r\n  Configuration is valid!\r\r\n    VM Name: vmctl-t-vmdk-ide\r\r\n    CPU:     1 cores\r\r\n    Memory:  128 MB\r\r\n    Disks:   1\r\r\n  -> exit 0\r\r\n  [ok] the spec validates\r\r\n$ vmctl -p vmware import C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.yaml --policy nearest --execute\r\r\n  Created VM 'vmctl-t-vmdk-ide' from C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.yaml\r\r\n      1: mkdir C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide\r\r\n      2: C:\\Program Files\\VMware\\VMware Workstation\\vmware-vdiskmanager -q -c -s 100MB -a ide -t 0 C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide\\vmctl-t-vmdk-ide_system.vmdk\r\r\n      3: write C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide\\vmctl-t-vmdk-ide.vmx (829 bytes)\r\r\n  -> exit 0\r\r\n  [ok] the VM is created\r\r\n$ vmctl -p vmware list\r\r\n  NAME                           STATUS      \r\r\n  ------------------------------------------\r\r\n  Windows 98                     stopped     \r\r\n  vmctl-t-vmdk-ide               stopped     \r\r\n  -> exit 0\r\r\n  [ok] the hypervisor lists it\r\r\n$ vmctl -p vmware import C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.yaml --policy nearest --execute\r\r\n  Provider error: Virtual Machine 'vmctl-t-vmdk-ide' already exists\r\r\n    vm name: vmctl-t-vmdk-ide\r\r\n    operation: create_vm\r\r\n    hint: Use a different name or delete the existing VM first\r\r\n  -> exit 1\r\r\n  [ok] importing the same file again is refused, not silently doubled -- exit 1\r\r\n$ vmctl -p vmware import C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.yaml --new-name vmctl-t-vmdk-ide-ov --set memory.mb=256 --set cpu.count=2 --add-disk name=data,size_mb=100,bus=ide,format=vmdk --policy nearest --execute\r\r\n  Created VM 'vmctl-t-vmdk-ide-ov' from C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.yaml\r\r\n      1: mkdir C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-ov\r\r\n      2: C:\\Program Files\\VMware\\VMware Workstation\\vmware-vdiskmanager -q -c -s 100MB -a ide -t 0 C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-ov\\vmctl-t-vmdk-ide-ov_system.vmdk\r\r\n      3: C:\\Program Files\\VMware\\VMware Workstation\\vmware-vdiskmanager -q -c -s 100MB -a ide -t 0 C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-ov\\vmctl-t-vmdk-ide-ov_data.vmdk\r\r\n      4: write C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-ov\\vmctl-t-vmdk-ide-ov.vmx (939 bytes)\r\r\n  Overrides applied:\r\r\n    storage[1].name = 'data' (from --add-disk)\r\r\n    storage[1].size_mb = 100 (from --add-disk)\r\r\n    storage[1].bus = 'ide' (from --add-disk)\r\r\n    storage[1].format = 'vmdk' (from --add-disk)\r\r\n    memory.mb = 256 (from --set, was 128)\r\r\n    cpu.count = 2 (from --set, was 1)\r\r\n    name = 'vmctl-t-vmdk-ide-ov' (from --new-name, was 'vmctl-t-vmdk-ide')\r\r\n  -> exit 0\r\r\n  [ok] the overridden VM is created\r\r\n$ vmctl -p vmware read vmctl-t-vmdk-ide-ov --format json\r\r\n  {\r\r\n    \"name\": \"vmctl-t-vmdk-ide-ov\",\r\r\n    \"arch\": \"x86_64\",\r\r\n    \"machine\": null,\r\r\n    \"guest_os\": \"ubuntu\",\r\r\n    \"description\": null,\r\r\n    \"cpu\": {\r\r\n      \"count\": 2,\r\r\n      \"hotplug\": false,\r\r\n      \"execution_cap\": 100,\r\r\n      \"pae\": false,\r\r\n      \"nested_virt\": false,\r\r\n      \"sockets\": null,\r\r\n      \"cores\": null,\r\r\n      \"threads\": null,\r\r\n      \"model\": null\r\r\n    },\r\r\n    \"memory\": {\r\r\n      \"mb\": 256,\r\r\n      \"vram_mb\": 16,\r\r\n      \"page_fusion\": false,\r\r\n      \"ballooning\": false\r\r\n    },\r\r\n    \"firmware\": {\r\r\n      \"type\": \"bios\",\r\r\n      \"secure_boot\": false,\r\r\n      \"tpm\": false\r\r\n    },\r\r\n    \"storage\": [\r\r\n      {\r\r\n        \"name\": \"ide0_0\",\r\r\n        \"kind\": \"disk\",\r\r\n        \"bus\": \"ide\",\r\r\n        \"controller\": \"ide0\",\r\r\n        \"slot\": 0,\r\r\n        \"unit\": 0,\r\r\n        \"size_mb\": 100,\r\r\n        \"format\": \"vmdk\",\r\r\n        \"allocation\": \"thin\",\r\r\n        \"readonly\": false,\r\r\n  -> exit 0\r\r\n  [ok] the VM reads back as JSON\r\r\n  [ok] the "]
[16.491433, "o", "memory override reached the hypervisor -- reported 256 MB\r\r\n  [ok] the CPU override reached the hypervisor -- reported 2\r\r\n  [ok] the added disk is there -- 2 storage device(s)\r\r\n  [ok] the disks are vmdk as asked -- reported ['vmdk']\r\r\n  [ok] the disks are on ide as asked -- reported ['ide']\r\r\n$ vmctl -p vmware export vmctl-t-vmdk-ide-ov -o C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.json\r\r\n  Exported 'vmctl-t-vmdk-ide-ov' -> C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.json\r\r\n  -> exit 0\r\r\n  [ok] export writes the file\r\r\n  [ok] a .json file contains JSON\r\r\n$ vmctl -p vmware import C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.json --new-name vmctl-t-vmdk-ide-rt --policy nearest --execute\r\r\n  Created VM 'vmctl-t-vmdk-ide-rt' from C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.json\r\r\n      1: mkdir C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-rt\r\r\n      2: C:\\Program Files\\VMware\\VMware Workstation\\vmware-vdiskmanager -q -c -s 100MB -a ide -t 0 C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-rt\\vmctl-t-vmdk-ide-rt_ide0_0.vmdk\r\r\n      3: C:\\Program Files\\VMware\\VMware Workstation\\vmware-vdiskmanager -q -c -s 100MB -a ide -t 0 C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-rt\\vmctl-t-vmdk-ide-rt_ide0_1.vmdk\r\r\n      4: write C:\\Users\\aaaha\\Documents\\Virtual Machines\\vmctl-t-vmdk-ide-rt\\vmctl-t-vmdk-ide-rt.vmx (941 bytes)\r\r\n  Overrides applied:\r\r\n    name = 'vmctl-t-vmdk-ide-rt' (from --new-name, was 'vmctl-t-vmdk-ide-ov')\r\r\n  -> exit 0\r\r\n  [ok] the exported JSON imports again\r\r\n$ vmctl -p vmware diff vmctl-t-vmdk-ide-ov C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-handson-47rk5x39\\vmctl-t-vmdk-ide.json\r\r\n  vmctl-t-vmdk-ide-ov matches C:\\Users\\aaaha\\AppData\\Local\\Temp\\vmctl-ha